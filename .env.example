# --- Database (Prisma) ---
# Folio targets PostgreSQL (native enums + JSON). Point this at a local or
# managed Postgres instance, then run `npm run db:push && npm run db:seed`.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/folio?schema=public"

# --- Folio AI ---
# The AI route (/api/ai) falls back to a deterministic local engine when no
# key is present, so the app works end-to-end without any external service.
# Provide a key to enable a real LLM-backed co-pilot.
ANTHROPIC_API_KEY=""
FOLIO_AI_MODEL="claude-opus-4-8"

# --- App ---
NEXT_PUBLIC_APP_NAME="Folio"
