# --- Database (Prisma) ---
# Folio targets PostgreSQL (native enums + JSON). Point this at a local or
# managed Postgres instance, then run `npm run db:push && npm run db:seed`.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/folio?schema=public"

# --- Folio AI ---
# With a key, /api/ai answers with Claude, grounded in the user's portfolio.
# Without one (or if the API fails), a deterministic local engine answers, so
# the app works end-to-end with no external service.
ANTHROPIC_API_KEY=""
# Optional override; defaults to claude-opus-5-5.
FOLIO_AI_MODEL=""

# --- App ---
NEXT_PUBLIC_APP_NAME="Folio"
