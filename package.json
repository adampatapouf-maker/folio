{
  "name": "folio",
  "version": "1.0.0",
  "private": true,
  "description": "Folio — AI investment co-pilot. Mobile-first fintech PWA.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "wrangler dev",
    "deploy": "wrangler deploy --keep-vars",
    "upload": "wrangler versions upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@opennextjs/cloudflare": "^1.20.12",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "10.4.19",
    "esbuild": "^0.28.2",
    "next": "^16.4.2",
    "postcss": "8.4.39",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "tailwindcss": "3.4.6",
    "typescript": "5.5.3",
    "wrangler": "^4.151.1",
    "zustand": "4.5.4"
  },
  "devDependencies": {
    "@prisma/client": "5.18.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.2",
    "prisma": "5.18.0",
    "tsx": "4.16.2",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
